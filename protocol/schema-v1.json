{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meodesk.local/protocol/schema-v1.json",
  "title": "M\u00e8oDesk local HTTP protocol v1",
  "$defs": {
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "telemetry": {
      "type": "object",
      "required": [
        "cpu_percent",
        "ram_percent"
      ],
      "properties": {
        "schema": {
          "type": "integer",
          "const": 1
        },
        "pc_name": {
          "type": "string",
          "maxLength": 29
        },
        "cpu_percent": {
          "$ref": "#/$defs/percent"
        },
        "gpu_percent": {
          "oneOf": [
            {
              "$ref": "#/$defs/percent"
            },
            {
              "type": "null"
            }
          ]
        },
        "ram_percent": {
          "$ref": "#/$defs/percent"
        },
        "cpu_temp_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "gpu_temp_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "net_up_kbps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "net_down_kbps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "vram_used_gb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "vram_total_gb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "battery_percent": {
          "oneOf": [
            {
              "$ref": "#/$defs/percent"
            },
            {
              "type": "null"
            }
          ]
        },
        "battery_plugged": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "demo": {
          "type": "boolean"
        },
        "pc_idle_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 604800
        }
      },
      "additionalProperties": true
    },
    "media": {
      "type": "object",
      "required": [
        "available",
        "playing",
        "title",
        "artist",
        "position_ms",
        "duration_ms"
      ],
      "properties": {
        "schema": {
          "type": "integer",
          "const": 1
        },
        "available": {
          "type": "boolean"
        },
        "playing": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "maxLength": 64
        },
        "artist": {
          "type": "string",
          "maxLength": 48
        },
        "artwork_id": {
          "type": "string",
          "pattern": "^$|^[a-f0-9]{16}$"
        },
        "position_ms": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": [
        "seq",
        "action"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": [
            "play_pause",
            "next",
            "previous"
          ]
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8000
        }
      },
      "additionalProperties": false
    },
    "command_ack": {
      "type": "object",
      "required": [
        "seq",
        "ok"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "ok": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "wifi_config": {
      "type": "object",
      "required": [
        "ssid",
        "password"
      ],
      "properties": {
        "ssid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "password": {
          "type": "string",
          "maxLength": 63
        }
      },
      "additionalProperties": false
    },
    "device_profile": {
      "type": "object",
      "required": [
        "theme",
        "fps_profile",
        "motion_style",
        "focus_work_min",
        "focus_break_min",
        "focus_goal",
        "cpu_limit",
        "gpu_limit",
        "temp_limit",
        "battery_limit",
        "motion",
        "auto_pages",
        "quiet",
        "scene_slots"
      ],
      "properties": {
        "theme": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "fps_profile": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "motion_style": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "focus_work_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "focus_break_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "focus_goal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "cpu_limit": {
          "type": "integer",
          "minimum": 50,
          "maximum": 99
        },
        "gpu_limit": {
          "type": "integer",
          "minimum": 50,
          "maximum": 99
        },
        "temp_limit": {
          "type": "integer",
          "minimum": 55,
          "maximum": 110
        },
        "battery_limit": {
          "type": "integer",
          "minimum": 5,
          "maximum": 50
        },
        "motion": {
          "type": "boolean"
        },
        "auto_pages": {
          "type": "boolean"
        },
        "quiet": {
          "type": "boolean"
        },
        "scene_slots": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 14
          }
        }
      },
      "additionalProperties": false
    },
    "focus_plan": {
      "type": "object",
      "required": [
        "work_min",
        "break_min",
        "goal"
      ],
      "properties": {
        "work_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "break_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "goal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      }
    },
    "scene_layout": {
      "type": "object",
      "required": [
        "schema",
        "widgets"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "widgets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "x",
              "y",
              "w",
              "h",
              "label"
            ],
            "properties": {
              "kind": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 161
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 119
              },
              "w": {
                "type": "integer",
                "minimum": 32,
                "maximum": 162
              },
              "h": {
                "type": "integer",
                "minimum": 20,
                "maximum": 120
              },
              "label": {
                "type": "string",
                "maxLength": 31,
                "pattern": "^[ -~]*$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "description": "Application validation also enforces boundaries and no overlap."
    }
  }
}
