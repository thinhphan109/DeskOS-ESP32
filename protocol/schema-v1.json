{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meodesk.local/protocol/schema-v1.json",
  "title": "MèoDesk local HTTP protocol v1",
  "$defs": {
    "percent": {"type": "number", "minimum": 0, "maximum": 100},
    "telemetry": {
      "type": "object", "required": ["cpu_percent", "ram_percent"],
      "properties": {
        "schema": {"type": "integer", "const": 1},
        "pc_name": {"type": "string", "maxLength": 29},
        "cpu_percent": {"$ref": "#/$defs/percent"},
        "gpu_percent": {"oneOf": [{"$ref": "#/$defs/percent"}, {"type": "null"}]},
        "ram_percent": {"$ref": "#/$defs/percent"},
        "cpu_temp_c": {"type": ["number", "null"]},
        "gpu_temp_c": {"type": ["number", "null"]},
        "net_up_kbps": {"type": ["number", "null"], "minimum": 0},
        "net_down_kbps": {"type": ["number", "null"], "minimum": 0},
        "vram_used_gb": {"type": ["number", "null"], "minimum": 0},
        "vram_total_gb": {"type": ["number", "null"], "minimum": 0},
        "battery_percent": {"oneOf": [{"$ref": "#/$defs/percent"}, {"type": "null"}]},
        "battery_plugged": {"type": ["boolean", "null"]},
        "demo": {"type": "boolean"}
      }, "additionalProperties": true
    },
    "media": {
      "type": "object", "required": ["available", "playing", "title", "artist", "position_ms", "duration_ms"],
      "properties": {
        "schema": {"type": "integer", "const": 1},
        "available": {"type": "boolean"},
        "playing": {"type": "boolean"},
        "title": {"type": "string", "maxLength": 64},
        "artist": {"type": "string", "maxLength": 48},
        "artwork_id": {"type": "string", "pattern": "^$|^[a-f0-9]{16}$"},
        "position_ms": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0}
      }, "additionalProperties": false
    },
    "command": {
      "type": "object", "required": ["seq", "action"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1},
        "action": {"enum": ["play_pause", "next", "previous"]},
        "ttl_ms": {"type": "integer", "minimum": 0, "maximum": 8000}
      }, "additionalProperties": false
    },
    "command_ack": {
      "type": "object", "required": ["seq", "ok"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1},
        "ok": {"type": "boolean"}
      }, "additionalProperties": false
    },
    "wifi_config": {
      "type": "object", "required": ["ssid", "password"],
      "properties": {
        "ssid": {"type": "string", "minLength": 1, "maxLength": 32},
        "password": {"type": "string", "maxLength": 63}
      }, "additionalProperties": false
    }
  }
}
